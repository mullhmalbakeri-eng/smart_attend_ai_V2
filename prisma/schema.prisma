generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Employee {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String
  password     String
  role         String       @default("EMPLOYEE")
  departmentId Int
  createdAt    DateTime     @default(now())
  attendances  Attendance[]
  qrTokens     QrToken[]
  department   Department   @relation(fields: [departmentId], references: [id])
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]
}

model Attendance {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  timestamp  DateTime @default(now())
  type       String
  status     String
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model QrToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  employeeId Int
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  employee   Employee @relation(fields: [employeeId], references: [id])
  
  @@index([token])
  @@index([expiresAt])
  @@index([employeeId])
}

model CompanySettings {
  id                 String   @id @default(cuid())
  companyName        String   @default("شركة الاتحاد")
  logoUrl            String?
  workStartTime      String   @default("09:00")
  workEndTime        String   @default("17:00")
  gracePeriodMinutes Int      @default(15)
  qrRefreshInterval  Int      @default(30)
  createdAt          DateTime @default(now())
}